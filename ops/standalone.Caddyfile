# Default /etc/caddy/Caddyfile baked into the published web image
# (ghcr.io/witchesofthehill/manabrew-web). Serves the app on :80 with the cross-origin isolation
# headers SharedArrayBuffer needs, so `docker run` works with no mounted config.
#
# For automatic HTTPS, mount your own Caddyfile over /etc/caddy/Caddyfile with a
# real hostname (see ops/Caddyfile), or terminate TLS in a proxy in front.
:80 {
	root * /srv/manabrew

	encode zstd gzip

	# Proxy only public Hub avatar objects from the configured fixed bucket.
	# Keeping the exact UUID/avatar/<uuid>.webp path shape makes this a narrow
	# same-origin image route, not a general-purpose proxy.
	@hubAvatar path_regexp hub_avatar ^/codex-assets-r2/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/avatar/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\.webp$
	handle @hubAvatar {
		@read method GET HEAD
		handle @read {
			uri strip_prefix /codex-assets-r2
			reverse_proxy https://pub-ffa167cacd604dd790f6c11b0f4423ca.r2.dev {
				header_up Host pub-ffa167cacd604dd790f6c11b0f4423ca.r2.dev
				header_up -Cookie
				header_up -Authorization
				header_up -Origin
				header_up -Referer
			}
			header {
				Cross-Origin-Resource-Policy "same-origin"
			}
		}
		handle {
			respond 405
		}
	}

	# Runtime relay config (rewritten from RELAY_* env on start) — never cache it.
	@config path /config.js
	handle @config {
		header Cache-Control "no-store"
		file_server
	}

	# Mana symbol proxy: served same-origin so symbols never depend on the
	# box's direct egress to svgs.scryfall.io and stay COEP-clean. The app
	# points here via VITE_SCRYFALL_SYMBOL_BASE=/scryfall-symbols/.
	@scryfall path_regexp scryfall ^/scryfall-symbols/(.*)$
	handle @scryfall {
		rewrite * /card-symbols/{re.scryfall.1}
		reverse_proxy https://svgs.scryfall.io {
			header_up Host svgs.scryfall.io
			header_down -Access-Control-Allow-Origin
			header_down -Cross-Origin-Resource-Policy
			header_down -Cache-Control
		}
		header Cache-Control "public, max-age=604800"
		header Cross-Origin-Resource-Policy "same-origin"
	}

	@cubecobra path_regexp cubecobra ^/cubecobra-download/cube/download/forge/([A-Za-z0-9-]+)$
	handle @cubecobra {
		rewrite * /cube/download/forge/{re.cubecobra.1}
		reverse_proxy https://cubecobra.com {
			header_up Host cubecobra.com
			header_down -Access-Control-Allow-Origin
			header_down -Set-Cookie
		}
		header Cross-Origin-Resource-Policy "same-origin"
	}

	handle {
		header {
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Embedder-Policy "require-corp"
			Cross-Origin-Resource-Policy "same-origin"
		}
		try_files {path} /index.html
		file_server
	}
}
