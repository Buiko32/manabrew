msgstr "Suspendida · {time} contadores de tiempo"

#: src/lib/cardKeywords.ts:18
msgid "This creature can assign excess combat damage to the player, planeswalker, or battle it's attacking."
msgstr "Esta criatura puede asignar el daño de combate sobrante al jugador, planeswalker o batalla al que está atacando."

#: src/lib/cardKeywords.ts:31
msgid "This creature can attack and use tap abilities even if it hasn't been under your control since your turn began."
msgstr "Esta criatura puede atacar y activar habilidades de girar aunque no haya estado bajo tu control desde que empezó tu turno."

#: src/lib/cardKeywords.ts:6
msgid "This creature can be blocked only by creatures with flying or reach."
msgstr "Esta criatura solo puede ser bloqueada por criaturas con la habilidad de volar o de alcance."

#: src/lib/cardKeywords.ts:28
msgid "This creature can block creatures with flying."
msgstr "Esta criatura puede bloquear criaturas con la habilidad de volar."

#: src/lib/cardKeywords.ts:42
msgid "This creature can't attack."
msgstr "Esta criatura no puede atacar."

#: src/lib/cardKeywords.ts:57
msgid "This creature can't be blocked by creatures with greater power."
msgstr "Esta criatura no puede ser bloqueada por criaturas con mayor fuerza."

#: src/lib/cardKeywords.ts:51
msgid "This creature can't be blocked except by artifact creatures and black creatures."
msgstr "Esta criatura no puede ser bloqueada excepto por criaturas artefacto y criaturas negras."

#: src/lib/cardKeywords.ts:55
msgid "This creature can't be blocked except by artifact creatures and creatures that share a color with it."
msgstr "Esta criatura no puede ser bloqueada excepto por criaturas artefacto y criaturas que compartan un color con ella."

#: src/lib/cardKeywords.ts:37
msgid "This creature can't be blocked except by two or more creatures."
msgstr "Esta criatura no puede ser bloqueada excepto por dos o más criaturas."

#: src/lib/cardKeywords.ts:13
msgid "This creature deals both first-strike and regular combat damage."
msgstr "Esta criatura hace daño de combate tanto de dañar primero como daño de combate normal."

#: src/lib/cardKeywords.ts:9
msgid "This creature deals combat damage before creatures without first strike or double strike."
msgstr "Esta criatura hace daño de combate antes que las criaturas sin dañar primero ni dañar dos veces."

#: src/lib/cardKeywords.ts:77
msgid "This permanent can't be damaged, enchanted, equipped, blocked, or targeted by anything with the specified quality."
msgstr "Este permanente no puede recibir daño, ser encantado, equipado, bloqueado ni ser objetivo de nada que tenga la cualidad especificada."

#: src/lib/cardKeywords.ts:40
msgid "This permanent can't be destroyed by lethal damage or effects that say “destroy”."
msgstr "Este permanente no puede ser destruido por daño letal ni por efectos que digan “destruye”."

#: src/lib/cardKeywords.ts:35
msgid "This permanent can't be the target of spells or abilities your opponents control."
msgstr "Este permanente no puede ser objetivo de hechizos o habilidades que controlen tus oponentes."

#: src/lib/cardKeywords.ts:48
msgid "This permanent can't be the target of spells or abilities."
msgstr "Este permanente no puede ser objetivo de hechizos o habilidades."

#: src/components/game/RulesPreviewAccessibility.tsx:135
msgid "To solve"
msgstr "Resolver"

#: src/lib/cardKeywords.ts:17
msgid "Trample"
msgstr "Arrollar"

#: src/lib/cardKeywords.ts:72
msgid "Undying"
msgstr "Inmortal"

#: src/pixi/cardPreview/previewMechanics.ts:104
msgid "Unlocked"
msgstr "Abierta"

#: src/components/game/RulesPreviewAccessibility.tsx:143
msgid "Unsolved · inactive"
msgstr "Sin resolver · inactivo"

#: src/lib/cardKeywords.ts:15
msgid "Vigilance"
msgstr "Vigilancia"

#: src/lib/cardKeywords.ts:45
msgid "Ward"
msgstr "Resguardo"

#: src/lib/cardKeywords.ts:69
msgid "When this creature dies, if it had no -1/-1 counters on it, return it to the battlefield under its owner's control with a -1/-1 counter."
msgstr "Cuando esta criatura muera, si no tenía contadores -1/-1 sobre ella, regrésala al campo de batalla bajo el control de su propietario con un contador -1/-1."

#: src/lib/cardKeywords.ts:73
msgid "When this creature dies, if it had no +1/+1 counters on it, return it to the battlefield under its owner's control with a +1/+1 counter."
msgstr "Cuando esta criatura muera, si no tenía contadores +1/+1 sobre ella, regrésala al campo de batalla bajo el control de su propietario con un contador +1/+1."

#: src/lib/cardKeywords.ts:46
msgid "Whenever an opponent targets this permanent, counter that spell or ability unless they pay its ward cost."
msgstr "Siempre que un oponente haga objetivo a este permanente, contrarresta ese hechizo o habilidad a menos que pague su coste de resguardo."

#: src/lib/cardKeywords.ts:60
msgid "Whenever you cast a noncreature spell, this creature gets +1/+1 until end of turn."
msgstr "Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno."

#: src/lib/cardKeywords.ts:66
msgid "Wither"
msgstr "Debilitar"

#: src/lib/cardKeywords.ts:144
msgid "You may cast this card from your graveyard by paying {parameter} instead of its mana cost. If it would leave the stack, exile it instead."
msgstr "Puedes lanzar esta carta desde tu cementerio pagando {parameter} en vez de su coste de maná. Si fuera a dejar la pila, en vez de eso, exíliala."

#: src/lib/cardKeywords.ts:81
msgid "You may cast this card from your graveyard for its flashback cost. If it would leave the stack, exile it instead."
msgstr "Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Si fuera a dejar la pila, en vez de eso, exíliala."

#: src/lib/cardKeywords.ts:43
msgid "You may cast this spell any time you could cast an instant."
msgstr "Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo."
